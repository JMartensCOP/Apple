[global]
    monitor = 0
    follow = keyboard
    geometry = "300x5-30+20"
    indicate_hidden = yes
    shrink = no
    transparency = 10
    notification_height = 0
    separator_height = 2
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 12
    sort = yes
    idle_threshold = 120
    font = Inter 10
    line_height = 0
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    show_age_threshold = 60
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes
    icon_position = left
    min_icon_size = 32
    max_icon_size = 64
    icon_path = /usr/share/icons/Papirus/16x16/status/:/usr/share/icons/Papirus/16x16/devices/
    sticky_history = yes
    history_length = 20
    dmenu = /usr/bin/dmenu -nb '#171738' -nf '#F5F7FA' -sb '#67C7E8' -sf '#171738'
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst
    corner_radius = 14
    ignore_dbusclose = false
    force_xwayland = false
    force_xinerama = false

    origin = top-right
    offset = 20x50
    width = 380
    height = 120
    frame_width = 1
    frame_color = "#67C7E8"
    separator_color = frame
    sort = yes
    idle_threshold = 120

    background = "#171738"
    foreground = "#F5F7FA"
    frame_width = 1
    frame_color = "#67C7E8"

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#171738"
    foreground = "#F5F7FA"
    frame_color = "#67C7E8"
    timeout = 10

[urgency_normal]
    background = "#171738"
    foreground = "#F5F7FA"
    frame_color = "#67C7E8"
    timeout = 10

[urgency_critical]
    background = "#8F232D"
    foreground = "#F5F7FA"
    frame_color = "#C83A36"
    timeout = 0
